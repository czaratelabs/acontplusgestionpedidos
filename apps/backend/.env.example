# =============================================================================
# Autenticación JWT
# =============================================================================
# Requerido. Generar con: openssl rand -base64 32
JWT_SECRET=cambiar-por-cadena-aleatoria-de-256-bits

# =============================================================================
# Configuración de base de datos - Supabase / PostgreSQL
# =============================================================================
# Copia este archivo a .env y reemplaza con tus credenciales reales.
# En Supabase: Project Settings > Database > Connection string (URI)
# =============================================================================

# --- IMPORTANTE: "Tenant or user not found" = pooler (6543) exige usuario postgres.[PROJECT_REF] ---
# Solución A: Usar la URI completa de Supabase (Database > Connection string > Transaction) - ya incluye postgres.XXX
# Solución B: Definir SUPABASE_PROJECT_REF (Project Settings > General > Reference ID)
# DATABASE_POOLER_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# SUPABASE_PROJECT_REF=tu-project-ref

# Conexión por variables (host directo). Si obtienes ENOTFOUND, usa DATABASE_POOLER_URL (arriba).
# DB_HOST=db.[PROJECT_REF].supabase.co
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=tu-password-de-base-de-datos
# DB_DATABASE=postgres

# SSL: true para Supabase (se activa automáticamente si el host es *.supabase.co o pooler)
DB_SSL=true

# Connection string (URI). Session = directa; si falla con ENOTFOUND, pon la URI del pooler en DATABASE_POOLER_URL.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Desarrollo local (Postgres en localhost): descomenta para no usar Supabase
# USE_LOCAL_DB=true

# CORS: orígenes permitidos separados por coma (producción)
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Seed inicial (npm run seed): usuario Super Admin para primer acceso
# =============================================================================
# SEED_SUPER_ADMIN_EMAIL=admin@tudominio.com
# SEED_SUPER_ADMIN_PASSWORD=tu-password-seguro
